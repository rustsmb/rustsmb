# Dockerfile for smbtorture client only
#
# This image contains only the smbtorture test tools.
# The SMB server runs on the host for faster iteration.
#
# Build:
#   docker build -f tests/Dockerfile.smbtorture -t smbtorture-client tests/
#
# Run (connect to host SMB server):
#   docker run --rm --add-host=host.docker.internal:host-gateway \
#     smbtorture-client smb2.connect
#
# Run all tests:
#   docker run --rm --add-host=host.docker.internal:host-gateway \
#     smbtorture-client all

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install smbtorture and smbclient
RUN rm -rf /var/lib/apt/lists/* && \
    apt-get update && \
    apt-get install -y --fix-missing \
    samba-testsuite \
    smbclient \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy test runner script
COPY smbtorture.sh /usr/local/bin/run-smbtorture
RUN chmod +x /usr/local/bin/run-smbtorture

# Create results directory
RUN mkdir -p /app/test-results

# Default environment - connect to host
ENV SMB_HOST=host.docker.internal
ENV SMB_PORT=4450
ENV SMB_SHARE=test
ENV SMB_USER=testuser
ENV SMB_PASS=testpass
ENV RESULTS_DIR=/app/test-results

ENTRYPOINT ["/usr/local/bin/run-smbtorture"]
CMD ["all"]
